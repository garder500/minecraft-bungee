# Copy to .env. Values below are a disposable 26.3 development baseline.
# Review Creative ZIP before selecting production versions. Never use latest.
STACK_ID=vampyuyu-local
PUID=1000
PGID=1000
DOCKER_GID=131
STATE_DIR=./state
SECRETS_DIR=./secrets
ARCHIVES_DIR=./archives
# Minecraft servers refuse startup until you explicitly accept the EULA.
EULA=FALSE
MC_VERSION=26.3
PAPER_BUILD=223
VELOCITY_VERSION=4.3.0
VELOCITY_BUILD=44
MC_IMAGE=itzg/minecraft-server:java25@sha256:3168dfa30c35fa1f99b8edde120f934a03ee780fcf905f450a1dbd9551d719f5
PROXY_IMAGE=itzg/bungeecord:java25@sha256:6a4a8819ec7665f5b03922d65304ece690148a34f8793bbf94d5515a34b00a4e
LOBBY_MEMORY=1G
CREATIVE_MEMORY=6G
SURVIVAL_MEMORY=6G
LOBBY_LIMIT=2g
CREATIVE_LIMIT=8g
SURVIVAL_LIMIT=8g
MAX_PLAYERS=40
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
MC_BIND=127.0.0.1
# Shown in the TAB footer; production should use play.vampyuyu.win.
MC_CONNECT_ADDRESS=localhost:25565
# Production: change STACK_ID, MC_BIND=0.0.0.0 and PUBLIC_ORIGIN below.
PUBLIC_ORIGIN=http://localhost:5173
NETWORK_CURRENCY_NAME=Shards
IMAGE_REPOSITORY=ghcr.io/delikesance/minecraft-bungee
# Required immutable Git commit SHA when using production Compose.
IMAGE_TAG=replace-with-published-40-character-commit-sha
# scripts/deploy.sh also sets PANEL_/CONTROLLER_/SERVER_/LOBBY_/TOOLS_IMAGE_TAG to content tags (src-...).
TLS_DIR=./secrets/tls
# Optional menu resource pack: base URL players download /pack/<sha1>.zip from.
# Defaults to PUBLIC_ORIGIN in production and http://localhost:8080 locally.
# MENU_PACK_BASE_URL=
# Force the pack: clients that refuse it are disconnected. Enable only once the URL is public.
# MENU_PACK_REQUIRED=true
