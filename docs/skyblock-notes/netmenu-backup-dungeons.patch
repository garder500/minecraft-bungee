+func TestDungeonWorldsAreSkipped(t *testing.T) {
+	data, out := server(t, "26.3"), t.TempDir()
+	write(t, filepath.Join(data, "world/dimensions/minecraft/sb_hub/region/r.0.0.mca"), []byte("hub"))
+	write(t, filepath.Join(data, "world/dimensions/minecraft/sb_dungeon_a1b2/region/r.0.0.mca"), []byte("run"))
+	write(t, filepath.Join(data, "world/dimensions/minecraft/sb_dungeon_a1b2/level.dat"), []byte("run"))
+	write(t, filepath.Join(data, "sb_dungeon_c3d4/level.dat"), levelDat("26.3"))
+	info, e := Create(data, "survival", "26.3", out, "export")
+	if e != nil {
+		t.Fatal(e)
+	}
+	zr, e := zip.OpenReader(filepath.Join(out, info.Name))
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer zr.Close()
+	seen := map[string]bool{}
+	for _, f := range zr.File {
+		seen[f.Name] = true
+		if strings.Contains(f.Name, "sb_dungeon_") {
+			t.Fatal("a dungeon world was archived:", f.Name)
+		}
+	}
+	if !seen["payload/world/dimensions/minecraft/sb_hub/region/r.0.0.mca"] {
+		t.Fatal("the hub world must stay in the archive")
+	}
+	for _, rel := range []string{"sb_dungeon_c3d4", "sb_dungeon_c3d4/level.dat", "world/dimensions/minecraft/sb_dungeon_x", "world/sb_dungeonish"} {
+		want := strings.HasPrefix(rel, "world/sb_dungeonish")
+		if transientWorld(rel) == want {
+			t.Fatal("transientWorld", rel, "=", !want)
+		}
+	}
+}
