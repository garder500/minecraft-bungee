 func worldName(name string) bool { return worldRE.MatchString(name) && !reserved[name] }
 
+// transientWorld reports the throw-away Skyblock dungeon worlds (world/dimensions/<ns>/sb_dungeon_<run>, or a
+// top-level sb_dungeon_* folder on older layouts): a run creates and deletes them while a backup walks the tree.
+func transientWorld(rel string) bool {
+	parts := strings.Split(rel, "/")
+	if strings.HasPrefix(parts[0], "sb_dungeon_") {
+		return true
+	}
+	for i, part := range parts {
+		if part == "dimensions" && i+2 < len(parts) && strings.HasPrefix(parts[i+2], "sb_dungeon_") {
+			return true
+		}
+	}
+	return false
+}
